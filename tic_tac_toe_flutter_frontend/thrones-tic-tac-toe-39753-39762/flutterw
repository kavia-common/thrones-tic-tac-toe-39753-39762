#!/usr/bin/env bash
# flutterw: simple wrapper to run Flutter commands inside the app directory.
set -euo pipefail
ROOT_DIR="$(cd "$(dirname "$0")" && pwd)"
APP_DIR="${ROOT_DIR}/tic_tac_toe_flutter_frontend"

if [ ! -f "${APP_DIR}/pubspec.yaml" ]; then
  echo "flutterw error: ${APP_DIR}/pubspec.yaml not found" >&2
  exit 1
fi

cd "${APP_DIR}"
exec flutter "$@"
